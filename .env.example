# ============================================================
# 1v1Chat 环境变量示例（键集合与 backend/config.py 保持一致）
# 复制为 .env 后按需修改；不要提交真实 .env。
# ============================================================

# 运行环境：dev / prod（prod 触发 fail-fast：占位 JWT/key、APP_DEBUG=True 会拒绝启动）
APP_ENV=dev
APP_DEBUG=true

# ---- DeepSeek（OpenAI 兼容） ----
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LLM 运行模式：auto=有 key 就真调；mock=离线假回复（开发/CI 用）
LLM_MODE=auto

# ---- 数据库 ----
# 开发/演示：SQLite（自动启用 WAL）；生产候选：postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./data/1v1chat.db

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- JWT（M4.6：短期 access + 可撤销 refresh）----
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ---- 登录防爆破（M4.6）----
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MINUTES=15

# ---- 管理员一次性引导（M4.6；仅空表时生效，需两个都配置）----
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- 合规与披露（M4.7）----
COMPLIANCE_FLAG_ENABLED=true
DISCLOSURE_ENABLED=true
DISCLOSURE_TEXT=对面是AI扮演的虚拟角色，仅供角色扮演/销售陪练/反诈演练等实验用途，请勿当真，不要进行真实交易或转账。

# ---- 静态媒体目录 ----
MEDIA_DIR=./media

# ---- Redis（可选，M4.2）：多 worker 限流共享计数；留空则用进程内实现 ----
REDIS_URL=

# ---- CORS 白名单（JSON 数组；prod 不允许 *，建议显式列前端域名） ----
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- engine2（v0.3+） ----
ENGINE_VERSION=v2          # v2=engine2（v0.5 默认）；回滚设 v1
TURN_TIMEOUT_S=20
ACTOR_MAX_TOKENS=120
ACTOR_TEMPERATURE=0.9
HISTORY_LIMIT=10
ANALYZER_MODEL=            # 空则复用 DEEPSEEK_MODEL
GUARD_ENABLED=true
GUARD_SAMPLE_RATE=0.05
MSG_MAX_LEN=2000
CHAT_RATE_PER_MIN=30
STATE_FACTS_MAX=20
